# ---------------------------------------------------------------------------
# Bet Agent -- bezne nastaveni. Tenhle soubor JE v repozitari a da se upravit
# primo na GitHubu (tuzkou v prohlizeci); zmena plati od dalsiho behu.
# NEPATRI SEM zadne klice ani tokeny -- ty jsou v GitHub secrets a v lokalnim .env.
# ---------------------------------------------------------------------------

# --- Kurzova pasma ---------------------------------------------------------
# Zapas se zaradi podle bezneho (medianoveho) kurzu favorita. V kazdem pasmu
# prijde TIPS_PER_BAND tipu s nejvyssi sanci. Zapasy mimo pasma se jen
# potichu ukladaji (neposilaji se), aby slo pozdeji porovnat.
# Zapis '1.25+' znamena pasmo bez horni hranice (smi byt jen posledni).
# Jedno pasmo 1,26-1,30: nizsi i vyssi kurzy se jen potichu ukladaji.
ODDS_BANDS=1.26-1.30
TIPS_PER_BAND=10
# Stejne jako TIPS_PER_BAND = vsech 10 prilezitosti jsou hlavni tipy
# (vyssi hodnota by pod ne pridala dalsi kandidaty kratkym radkem).
LIST_PER_BAND=10
# Druha zprava s hotovym textem pro chat (Gemini / Claude / ChatGPT zdarma):
# vsechny vypsane zapasy + zadani -- staci zkopirovat a vlozit do chatu.
CHAT_PROMPT=true
# Sazka pro virtualni zisk ve statistikach -- jen meritko, ne doporuceni.
VIRTUAL_STAKE=100
# Tvrdy prah sance. 0 = bez prahu.
MIN_TIP_PROB=0.0

# --- Sporty ----------------------------------------------------------------
# individual = tenis | low_variance = tenis+basket
# core = tenis+basket+hazena | core_us = + americky fotbal
# wide = + baseball a hokej
SPORT_PROFILE=core_us
# SPORT_GROUPS ma prednost pred profilem (nazvy skupin od The Odds API).
SPORT_GROUPS=
# Zalozni sporty: dotahuji se AZ kdyz hlavni sporty nedaji aspon
# FALLBACK_MIN_TIPS prilezitosti v pasmech. Tenis chlapu je zaloha --
# verim mu mene, nez tymovym sportum.
FALLBACK_SPORT_GROUPS=Tennis
FALLBACK_MIN_TIPS=10
TENNIS_TOP_TIER_ONLY=false
SPORT_KEY_WHITELIST=
# Vyrazene souteze. Smi byt i vzor s hvezdickou.
# Zensky tenis je vyrazeny zamerne: je vyrazne variabilnejsi nez muzsky.
SPORT_KEY_BLACKLIST=tennis_wta_*
# Fotbal: zapnuty kvuli vsednim dnum (hokej ani baseball nemaji favority
# v pasmech). Tip je dvojita sance 1X (favorit vyhraje nebo remizuje) --
# v testu Serie A by do pasem padlo 6 z 10 zapasu. Dotaz na soutez bez
# zapasu v okne nic nestoji; placene jsou jen trhy po zapasech
# (1 kredit za zapas za trh, strop MAX_EVENT_MARKET_LOOKUPS).
ENABLE_SOCCER=true
# 1 = pondeli ... 7 = nedele. Prazdne = kazdy den (fotbal je hlavni zdroj
# prilezitosti, tak se bere vzdy, kdyz je k dispozici).
SOCCER_WEEKDAYS=
# double_chance (1X) je nejlevnejsi a do pasem se vejde nejcasteji.
# Pridanim draw_no_bet se cena na zapas zdvojnasobi.
SOCCER_MARKETS=double_chance
SOCCER_HOME_FAVOURITE_ONLY=true
# ALL = VSECHNY aktivni fotbalove ligy (aktualne 48). Prazdne = jen sest
# nejvetsich lig, nebo se daji vypsat vlastni klice oddelene carkou.
# Program soutezi se zjistuje zdarma, takze kredity stoji jen ligy, ktere
# v okne opravdu hraji -- a nejvys SOCCER_MAX_LEAGUES z nich.
SOCCER_LEAGUE_WHITELIST=ALL
# Strop placenych lig na den. Prednost maji evropske pohary a top ligy
# (SOCCER_PRIORITY_LEAGUES v config.py), pak ligy s nejvic zapasy.
SOCCER_MAX_LEAGUES=6
MAX_EVENT_MARKET_LOOKUPS=3

# --- Spotreba kreditu The Odds API -----------------------------------------
# Souteze, ktere zrovna nehraji, jsou zdarma -- strop je jen pojistka.
MAX_SPORT_KEYS=12
ODDS_REGIONS=eu
MIN_CREDITS_RESERVE=40
HTTP_TIMEOUT=20
HTTP_RETRIES=3

# --- Casove okno -----------------------------------------------------------
TIMEZONE=Europe/Prague
# 0 = zadny odstup pred zacatkem; tipy se posilaji, dokud zapas nezacal.
# (Kdyz chces mit cas na podani sazky, dej treba 45.)
MIN_MINUTES_BEFORE_START=0
# 24 = cely den i nadchazejici noc (NBA zacina v SEC casto az po pulnoci).
MAX_HOURS_AHEAD=24
SAME_DAY_ONLY=false

# --- Spolehlivost odhadu ---------------------------------------------------
MIN_BOOKMAKERS=4
MAX_PROB_DISPERSION=0.04
DEVIG_METHOD=shin
TWO_WAY_ONLY=false
MAX_MARKET_DIVERGENCE=0.05

# --- AI debata (GPT x Claude) ----------------------------------------------
# Z kazdeho pasma se vezme AI_POOL_PER_BAND kandidatu. GPT ke kazdemu zapasu
# s vyhledavanim na webu pripravi rozbor (forma, zraneni, H2H, styl, program,
# motivace, pocasi, co cekaji preview). Pak se GPT (analytik) a Claude
# (skeptik) dohaduji, ktery zapas je v pasmu nejtutovejsi -- nejvys
# AI_MAX_TURNS odpovedi. Poradi pocita kod: 1. misto = shoda, jinak prumer
# obou odhadu. Do zpravy jde TIPS_PER_BAND. Prubeh debaty: slozka debaty/.
# Bezi jen s obema klici (GitHub secrets ANTHROPIC_API_KEY a OPENAI_API_KEY);
# jinak se posila cisty kurzovy vyber.
# Cena: GPT orientacne 6-10 USD mesicne (hlavne hledani), Claude 1-2 USD.
# Vypnuto -- misto placene debaty se posila text pro chat (CHAT_PROMPT).
AI_RANKING=false
AI_POOL_PER_BAND=5
AI_MAX_TURNS=4
# Shoda = stejne 1. misto A odhady jeho sance nejvys N procentnich bodu od sebe.
AI_AGREE_GAP=10
# low | medium | high -- hloubka uvazovani obou agentu v debate
AI_EFFORT=medium
# Skeptik (Anthropic)
AI_MODEL=claude-sonnet-5
# Resers a analytik (OpenAI)
OPENAI_RESEARCH_MODEL=gpt-5-mini
OPENAI_MODEL=gpt-5-mini
# Nejvys hledani na webu na jeden zapas (kazde stoji 0,01 USD).
OPENAI_MAX_SEARCHES=6
# low | medium | high -- jak dukladne GPT reserse premysli (vyssi = drazsi)
OPENAI_RESEARCH_EFFORT=medium

# --- Provoz ----------------------------------------------------------------
TRACK_RESULTS=true
STATE_FILE=
LOG_LEVEL=INFO
