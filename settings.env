# ---------------------------------------------------------------------------
# Bet Agent -- bezne nastaveni. Tenhle soubor JE v repozitari a da se upravit
# primo na GitHubu (tuzkou v prohlizeci); zmena plati od dalsiho behu.
# NEPATRI SEM zadne klice ani tokeny -- ty jsou v GitHub secrets a v lokalnim .env.
# ---------------------------------------------------------------------------

# --- Kurzova pasma ---------------------------------------------------------
# Zapas se zaradi podle bezneho (medianoveho) kurzu favorita. V kazdem pasmu
# prijde TIPS_PER_BAND tipu s nejvyssi sanci. Zapasy mimo pasma se jen
# potichu ukladaji (neposilaji se), aby slo pozdeji porovnat.
# Zapis '1.25+' znamena pasmo bez horni hranice (smi byt jen posledni).
ODDS_BANDS=1.15-1.19,1.20-1.24,1.25+
TIPS_PER_BAND=3
# Sazka pro virtualni zisk ve statistikach -- jen meritko, ne doporuceni.
VIRTUAL_STAKE=100
# Tvrdy prah sance. 0 = bez prahu.
MIN_TIP_PROB=0.0

# --- Sporty ----------------------------------------------------------------
# individual = tenis | low_variance = tenis+basket
# core = tenis+basket+hazena | wide = + baseball a hokej
SPORT_PROFILE=core
SPORT_GROUPS=
TENNIS_TOP_TIER_ONLY=false
SPORT_KEY_WHITELIST=
SPORT_KEY_BLACKLIST=
# Fotbal potrebuje drahe dotazy po zapasech (2 kredity za zapas).
ENABLE_SOCCER=false
SOCCER_MARKETS=double_chance,draw_no_bet
SOCCER_HOME_FAVOURITE_ONLY=true
SOCCER_LEAGUE_WHITELIST=
MAX_EVENT_MARKET_LOOKUPS=4

# --- Spotreba kreditu The Odds API -----------------------------------------
# Souteze, ktere zrovna nehraji, jsou zdarma -- strop je jen pojistka.
MAX_SPORT_KEYS=12
ODDS_REGIONS=eu
MIN_CREDITS_RESERVE=40
HTTP_TIMEOUT=20
HTTP_RETRIES=3

# --- Casove okno -----------------------------------------------------------
TIMEZONE=Europe/Prague
# 0 = zadny odstup pred zacatkem; tipy se posilaji, dokud zapas nezacal.
# (Kdyz chces mit cas na podani sazky, dej treba 45.)
MIN_MINUTES_BEFORE_START=0
# 24 = cely den i nadchazejici noc (NBA zacina v SEC casto az po pulnoci).
MAX_HOURS_AHEAD=24
SAME_DAY_ONLY=false

# --- Spolehlivost odhadu ---------------------------------------------------
MIN_BOOKMAKERS=4
MAX_PROB_DISPERSION=0.04
DEVIG_METHOD=shin
TWO_WAY_ONLY=false
MAX_MARKET_DIVERGENCE=0.05

# --- AI debata (Gemini x Claude) -------------------------------------------
# Z kazdeho pasma se vezme AI_POOL_PER_BAND kandidatu. Gemini k nim na webu
# (vyhledavani Google) dohleda zraneni, formu, program, motivaci, pocasi.
# Pak se Gemini (analytik) a Claude (skeptik) dohaduji, ktery zapas je
# v pasmu nejtutovejsi -- nejvys AI_MAX_TURNS odpovedi. Poradi pocita kod:
# 1. misto = shoda, jinak prumer obou odhadu. Do zpravy jde TIPS_PER_BAND.
# Bezi jen s obema klici (GitHub secrets ANTHROPIC_API_KEY a GEMINI_API_KEY);
# jinak se posila cisty kurzovy vyber. Prubeh debaty: slozka debaty/.
# Cena: Gemini v bezplatne urovni, Claude orientacne 2-4 USD mesicne.
AI_RANKING=true
AI_POOL_PER_BAND=5
AI_MAX_TURNS=4
# Shoda = stejne 1. misto A odhady jeho sance nejvys N procentnich bodu od sebe.
AI_AGREE_GAP=10
# Skeptik (Anthropic)
AI_MODEL=claude-sonnet-5
# low | medium | high -- vyssi = vic premysleni, drazsi
AI_EFFORT=medium
# Resers a analytik (Google). Bezplatne vyhledavani Google (grounding) maji
# jen tyto dva modely -- Gemini 3.x ho v bezplatne urovni vubec nema.
GEMINI_MODEL=gemini-2.5-flash
# Tempo dotazu (bezplatna uroven 2.5 Flash: 10 za minutu, 250 denne).
GEMINI_RPM=8

# --- Provoz ----------------------------------------------------------------
TRACK_RESULTS=true
STATE_FILE=
LOG_LEVEL=INFO
